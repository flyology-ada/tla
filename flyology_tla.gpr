with "flyology_json";

project Flyology_TLA is

   for Languages use ("Ada");
   for Source_Dirs use ("src", "tools");
   for Object_Dir use "build/obj";
   for Exec_Dir use "bin";
   for Main use ("flyology_tla_main.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatVa", "-gnatwa", "-gnatw.X", "-gnatyM110");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Builder is
      for Executable ("flyology_tla_main.adb") use "flyology-tla";
   end Builder;

   package Pretty_Printer is
      for Charset ("Ada") use "utf-8";
   end Pretty_Printer;

   package Install is
      for Artifacts (".") use ("share", "schema", "toolchain");
   end Install;

end Flyology_TLA;
