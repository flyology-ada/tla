with "flyology_tla";

project Counter_Conformance is

   --  Compile the generated model beside the small handwritten adapter, and
   --  keep build products in ignored example-local directories.
   for Languages use ("Ada");
   for Source_Dirs use ("src", "generated");
   for Object_Dir use "build/obj";
   for Exec_Dir use "bin";
   for Main use ("counter_conformance.adb");

   package Compiler is
      --  Match the reusable crate's warning-strict Ada 2022 build policy.
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatVa", "-gnatwa", "-gnatw.X", "-gnatyM110");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Builder is
      for Executable ("counter_conformance.adb") use "counter-conformance";
   end Builder;

end Counter_Conformance;
