with "flyology_tla";

project Flyology_TLA_Tests is

   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "build/obj";
   for Exec_Dir use "bin";
   for Main use
     ("flyology_tla_tests.adb", "flyology_tla_command_line_probe.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatVa", "-gnatwa", "-gnatw.X", "-gnatyM110");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Builder is
      for Executable ("flyology_tla_tests.adb") use "flyology-tla-tests";
      for Executable ("flyology_tla_command_line_probe.adb") use
        "flyology-tla-command-line-probe";
   end Builder;

end Flyology_TLA_Tests;
