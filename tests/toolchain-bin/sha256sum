#!/bin/sh
set -eu

file=
for argument in "$@"
do
  file=$argument
done
case "$file" in
  */tla2tools.jar)
    printf '%s  %s\n' \
      "${FLYOLOGY_TLA_TEST_JAR_DIGEST:-bb82311bc0493a8d30112a1baa0aece42a5f91b928866c7593930e390c14c340}" \
      "$file"
    ;;
  */tlapm.tar.gz)
    printf '%s  %s\n' ad1cb0a047ac2b5c33d6811d5d57c5bfbad4b317cd90299fee4302514f1bebde "$file"
    ;;
  */tlaps/bin/tlapm)
    printf '%s  %s\n' 291db0665c3b599f5343b03c06bcfb49b48ac966c39efff8643fa730f0d296b7 "$file"
    ;;
  *) exec /sbin/sha256sum "$@" ;;
esac
