{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flyology.dev/schema/tla/ada-inference-v1.schema.json",
  "title": "Flyology TLA+ Ada inference report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "module_path",
    "configuration",
    "package",
    "type_invariant",
    "input_type_operator",
    "outcome_type_operator",
    "source_sha256",
    "configuration_sha256",
    "semantic_xml_sha256",
    "state",
    "input",
    "outcome"
  ],
  "properties": {
    "format": { "const": "flyology.tla.ada-inference/1" },
    "module_path": { "type": "string", "minLength": 1 },
    "configuration": { "type": "string", "minLength": 1 },
    "package": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
    "type_invariant": { "type": "string", "minLength": 1 },
    "input_type_operator": { "type": "string", "minLength": 1 },
    "outcome_type_operator": { "type": "string", "minLength": 1 },
    "source_sha256": { "$ref": "#/$defs/sha256" },
    "configuration_sha256": { "$ref": "#/$defs/sha256" },
    "semantic_xml_sha256": { "$ref": "#/$defs/sha256" },
    "state": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["variable", "ada_field", "type", "evidence_line"],
        "properties": {
          "variable": { "type": "string", "minLength": 1 },
          "ada_field": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "evidence_line": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "input": { "type": "string", "minLength": 1 },
    "outcome": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
